---
import SplitLayout from '../layouts/SplitLayout.astro';
import { getSiteData } from '../lib/content';

const site = await getSiteData();

const workSections = [
	{ id: 'study', label: 'Study' },
	{ id: 'research', label: 'Research' },
	{ id: 'engineering', label: 'Engineering' },
];

const socials = site.profile.socials;
const gh = socials.find(s => s.platform === 'GitHub');
const email = socials.find(s => s.platform === 'Email');
const scholar = socials.find(s => s.platform === 'Scholar');
---

<SplitLayout
	title={`Work · ${site.seo.title}`}
	description="Projects, research, and technical writing."
	navigation={site.navigation.items}
	profile={site.profile}
	pathname="/work"
	activeSection="study"
	sidebarSections={workSections}
	layout="three-column"
	workSections={workSections}
>
	<div slot="work-left">
		<h1 class="work-left-name">{site.profile.name}</h1>
		<p class="work-left-tagline">Agent 研究者 · 工程驱动的设计者</p>
		<div class="work-left-links">
			{gh && <a class="work-left-link" href={gh.url} target="_blank" rel="noreferrer">GitHub</a>}
			{email && <a class="work-left-link" href={email.url}>Email</a>}
			{scholar && <a class="work-left-link" href={scholar.url} target="_blank" rel="noreferrer">Scholar</a>}
		</div>
	</div>

	<section id="study" class="work-section stagger-el">
		<h2 class="section-title">Study</h2>
		<div class="work-section-meta">
			<p>西南大学（211, 重庆）</p>
			<p>自动化专业 本科</p>
			<p>GPA 3.84 · Rank 5%</p>
			<p>CET-6 540 · 备考 IELTS 中</p>
		</div>
		<ul class="work-list">
			<li>西南大学校二等奖学金</li>
			<li>西南大学三好学生</li>
			<li>西南大学优秀共青团员</li>
			<li>挑战杯、大学生创新创业大赛等比赛经历若干</li>
		</ul>
	</section>

	<section id="research" class="work-section stagger-el">
		<h2 class="section-title">Research</h2>
		<div class="work-section-meta">
			<p>EZE LAB 成员，导师：<a href="https://huangjunjie-cs.github.io/" target="_blank" rel="noreferrer">黄俊杰副教授</a></p>
			<p>研究方向：AI Agent · RAG Safety</p>
		</div>
		<ul class="work-list">
			<li>CCS 2026 在审（第三作者）—— RAG 安全与对抗鲁棒性</li>
			<li>AAAI 已投稿 —— Hypergraph &amp; LLM</li>
		</ul>
		<ul class="work-list">
			<li class="work-list-ongoing">— Hypergraph &amp; LLM 实验进行中</li>
			<li class="work-list-ongoing">— 人机共生方向论文撰写中</li>
		</ul>
	</section>

	<section id="engineering" class="work-section stagger-el">
		<h2 class="section-title">Engineering</h2>
		<ul class="work-list">
			<li>Agent 工作流编排：多模型路由 + 上下文感知（2025.11–2026.01）</li>
			<li>Markdown 工具链：Agent skill 管理与上下文工程</li>
			<li>Harness Engineering：opencode skills 维护与 superpowers 集成</li>
			<li>多智能体系统：模型选择策略与团队协作设计</li>
		</ul>
		<ul class="work-list">
			<li class="work-list-ongoing">— LoRA 微调实验进行中</li>
		</ul>
	</section>
</SplitLayout>
