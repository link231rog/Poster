---
import SplitLayout from '../layouts/SplitLayout.astro';
import { getSiteData } from '../lib/content';

const site = await getSiteData();

const workSections = [
	{ id: 'study', label: 'Study' },
	{ id: 'research', label: 'Research' },
	{ id: 'engineering', label: 'Engineering' },
];
---

<SplitLayout
	title={site.seo.title}
	description="Projects, research, and technical writing."
	navigation={site.navigation.items}
	profile={site.profile}
	pathname="/"
	activeSection="study"
	sidebarSections={workSections}
>
	<section id="study" class="split-section stagger-el">
		<h2 class="section-title">Study</h2>

		<h3 class="subsection-title">Academic</h3>
		<ul class="subsection-list">
			<li>Southwest University (211, Chongqing)</li>
			<li>B.Eng. in Automation</li>
			<li class="cv-metric"><strong>GPA 3.84</strong> · Rank 5%</li>
			<li class="cv-metric"><strong>CET-6 540</strong> · Preparing for IELTS</li>
		</ul>

		<h3 class="subsection-title">Awards</h3>
		<ul class="subsection-list">
			<li>University Second-Class Scholarship</li>
			<li>Merit Student</li>
			<li>Outstanding League Member</li>
			<li>"Challenge Cup" University Innovation &amp; Entrepreneurship Competition (Second Lead)</li>
		</ul>

		<h3 class="subsection-title">Processing</h3>
		<ul class="subsection-list">
			<li class="processing-item">University Innovation &amp; Entrepreneurship Competition (Ongoing)</li>
		</ul>
	</section>

	<section id="research" class="split-section stagger-el">
		<h2 class="section-title">Research</h2>
		<div class="work-section-meta">
			<p>Research Assistant at <a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">DIGAI Lab</a>, HKUST(GZ), advised by <a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">Prof. Menglin Yang</a></p>
			<p>Research focus: <strong>Agent Memory</strong> · <strong>Multi-Agent Systems</strong></p>
		</div>
		<ul class="subsection-list">
			<li><strong>ARR Oct 2026</strong> under review (1st author) — Multi-Agent, Memory &amp; RL · HKUST(GZ), Tencent, SWU</li>
			<li>Member of <a href="https://huangjunjie-cs.github.io/" target="_blank" rel="noreferrer">EZE LAB</a>, supervised by Prof. Junjie Huang</li>
		</ul>
		<ul class="subsection-list">
			<li class="processing-item">Decision Model Harness research ongoing</li>
		</ul>
	</section>

	<section id="engineering" class="split-section stagger-el">
		<h2 class="section-title">Engineering</h2>
		<ul class="subsection-list">
			<li>Agent workflow orchestration: multi-model routing + context-aware selection (2025.11–2026.01)</li>
			<li>Markdown toolchain: Agent skill management &amp; context engineering</li>
			<li>Harness Engineering: opencode skills maintenance &amp; superpowers integration</li>
			<li>Multi-agent systems: model selection strategy &amp; team collaboration design</li>
		</ul>
		<ul class="subsection-list">
			<li class="processing-item">LoRA fine-tuning experiments ongoing</li>
			<li class="processing-item"><a href="https://project-fan-demo.pages.dev/" target="_blank" rel="noreferrer">Fan Blade Anatomy &amp; Prototype</a> (Interactive demo)</li>
		</ul>
		<div style="margin-top: 24px;">
			<a class="button-secondary" href={`${import.meta.env.BASE_URL}/projects`}>
				View all projects &amp; live demos &rarr;
			</a>
		</div>
	</section>
</SplitLayout>
