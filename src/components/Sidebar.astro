---
/**
 * Sidebar.astro - Sticky left sidebar with CV info and section nav.
 * Brittany Chiang style layout.
 */
import type { Profile } from '../types/content';

type Props = {
	profile: Profile;
	activeSection?: string;
	sections: Array<{ id: string; label: string }>;
};

const { profile, activeSection = '', sections } = Astro.props;
---

<aside class="sidebar stagger-el">
	<div class="sidebar-inner">
		<div class="sidebar-identity">
			<h1 class="sidebar-name">{profile.name}</h1>
			<p class="sidebar-headline">{profile.headline}</p>
			<ul class="cv-list sidebar-cv">
				<li>B.Eng. in Automation, Southwest University (211)</li>
				<li>Member of <a href="https://huangjunjie-cs.github.io/" target="_blank" rel="noreferrer">EZE LAB</a></li>
				<li>Research focus: AI Agent</li>
				<li>CCS 2026 under review (3rd author)</li>
				<li>AAAI 2027 · Processing</li>
			</ul>
		</div>

		<nav class="sidebar-nav" aria-label="In-page navigation">
			{sections.map((s) => (
				<a
					href={`#${s.id}`}
					class:list={['sidebar-nav-link', activeSection === s.id && 'is-active']}
					data-section={s.id}
				>
					<span class="nav-indicator"></span>
					<span class="nav-label">{s.label}</span>
				</a>
			))}
		</nav>

		<ul class="sidebar-socials text-links">
			{profile.socials.map((social) => (
				<li><a href={social.url} target="_blank" rel="noreferrer">{social.label}</a></li>
			))}
		</ul>
	</div>
</aside>

<script>
(() => {
	// Activation-line approach for active nav state.
	// Replaces IntersectionObserver which is unreliable for short bottom sections.
	const links = document.querySelectorAll('.sidebar-nav-link');
	if (!links.length) return;

	const scrollRoot = document.querySelector('.split-content');
	if (!scrollRoot) return;

	const sections = document.querySelectorAll('section[id]');
	if (!sections.length) return;

	// Activation line: px below the top of the scroll container
	const ACTIVATION_OFFSET = 120;

	function setActive(id: string) {
		links.forEach((link) => {
			link.classList.toggle('is-active', (link as HTMLElement).dataset.section === id);
		});
	}

	function updateActiveSection() {
		const scrollRect = scrollRoot.getBoundingClientRect();
		const activationLine = scrollRect.top + ACTIVATION_OFFSET;

		// At bottom → last section (handles short last sections reliably)
		if (scrollRoot.scrollHeight - scrollRoot.scrollTop <= scrollRoot.clientHeight + 1) {
			setActive(sections[sections.length - 1].id);
			return;
		}

		// Walk sections: the last one whose top ≤ activation line wins
		let activeId = sections[0].id;
		for (let i = 0; i < sections.length; i++) {
			const rect = sections[i].getBoundingClientRect();
			if (activationLine >= rect.top) {
				activeId = sections[i].id;
			} else {
				break;
			}
		}

		setActive(activeId);
	}

	let ticking = false;
	scrollRoot.addEventListener('scroll', () => {
		if (!ticking) {
			requestAnimationFrame(() => {
				updateActiveSection();
				ticking = false;
			});
			ticking = true;
		}
	});

	let resizeTimer: ReturnType<typeof setTimeout>;
	window.addEventListener('resize', () => {
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(updateActiveSection, 100);
	});

	// Initial active from server-rendered class; recalc on load
	updateActiveSection();
})();
</script>
