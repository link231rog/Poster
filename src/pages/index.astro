---
import ProjectCard from '../components/ProjectCard.astro';
import SplitLayout from '../layouts/SplitLayout.astro';
import { getProjects, getSiteData } from '../lib/content';

const [site, allProjects] = await Promise.all([getSiteData(), getProjects()]);

const featuredProjects = allProjects.filter(
	(p) => p.slug === 'chongqing-3d' || p.slug === 'fan-demo' || p.slug === 'fan-promo',
);

const sidebarSections = [
	{ id: 'research', label: 'Research', labelZh: '科研经历' },
	{ id: 'background', label: 'Background & Awards', labelZh: '学业与荣誉' },
	{ id: 'projects', label: 'Featured Projects', labelZh: '精选项目' },
];

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<SplitLayout
	title={site.seo.title}
	description="Research, publications, and academic background."
	navigation={site.navigation.items}
	profile={site.profile}
	pathname="/"
	activeSection="research"
	sidebarSections={sidebarSections}
>
	<section id="research" class="split-section stagger-el">
		<h2 class="section-title">
			<span class="lang-en">Research</span>
			<span class="lang-zh">科研经历</span>
		</h2>
		<div class="work-section-meta">
			<p>
				<span class="lang-en">Research Assistant at <a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">DIGAI Lab</a>, HKUST(GZ), advised by <a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">Prof. Menglin Yang</a></span>
				<span class="lang-zh">香港科技大学（广州）<a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">DIGAI Lab</a> 研究助理，师从 <a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">杨萌林教授</a></span>
			</p>
			<p>
				<span class="lang-en">Research focus: <strong>Agent Memory</strong> · <strong>Multi-Agent Systems</strong></span>
				<span class="lang-zh">核心研究方向：<strong>智能体记忆（Agent Memory）</strong> · <strong>多智能体系统（Multi-Agent Systems）</strong></span>
			</p>
		</div>
		<ul class="subsection-list">
			<li>
				<span class="lang-en"><strong>ARR Oct 2026</strong> under review (1st author) — Multi-Agent, Memory &amp; RL · HKUST(GZ), Tencent, SWU</span>
				<span class="lang-zh"><strong>ARR 2026.10</strong> 在审（第一作者）— Multi-Agent, Memory &amp; RL · 港科大（广州）/ 腾讯 / 西南大学</span>
			</li>
			<li>
				<span class="lang-en">Member of <a href="https://huangjunjie-cs.github.io/" target="_blank" rel="noreferrer">EZE LAB</a>, supervised by Prof. Junjie Huang</span>
				<span class="lang-zh">西南大学 <a href="https://huangjunjie-cs.github.io/" target="_blank" rel="noreferrer">EZE LAB</a> 成员，指导老师：黄俊杰教授</span>
			</li>
		</ul>
		<ul class="subsection-list">
			<li class="processing-item">
				<span class="lang-en">Decision Model Harness research ongoing</span>
				<span class="lang-zh">决策模型与 Harness 控制架构（在研推进中）</span>
			</li>
		</ul>
	</section>

	<section id="background" class="split-section stagger-el">
		<h2 class="section-title">
			<span class="lang-en">Background &amp; Awards</span>
			<span class="lang-zh">学业与荣誉</span>
		</h2>

		<h3 class="subsection-title">
			<span class="lang-en">Academic</span>
			<span class="lang-zh">学业表现</span>
		</h3>
		<ul class="subsection-list">
			<li>
				<span class="lang-en">HKUST(GZ)</span>
				<span class="lang-zh">香港科技大学（广州） HKUST(GZ)</span>
			</li>
			<li>
				<span class="lang-en">Southwest University (211) · Automation</span>
				<span class="lang-zh">西南大学（211）· 自动化</span>
			</li>
			<li class="cv-metric">
				<span class="lang-en"><strong>GPA 3.84</strong> · Rank 5%</span>
				<span class="lang-zh"><strong>GPA 3.84</strong> · 专业综合排名前 5%</span>
			</li>
			<li class="cv-metric">
				<span class="lang-en"><strong>CET-6 540</strong> · Preparing for IELTS</span>
				<span class="lang-zh"><strong>CET-6 540</strong> · 雅思备考中</span>
			</li>
		</ul>

		<h3 class="subsection-title">
			<span class="lang-en">Awards &amp; Competitions</span>
			<span class="lang-zh">竞赛与荣誉</span>
		</h3>
		<ul class="subsection-list">
			<li>
				<span class="lang-en">"Challenge Cup" University Innovation &amp; Entrepreneurship Competition (Second Lead)</span>
				<span class="lang-zh"><strong>“挑战杯”大学生创业计划竞赛（第二负责人）</strong></span>
			</li>
			<li>
				<span class="lang-en">University Second-Class Scholarship</span>
				<span class="lang-zh">校级二等奖学金</span>
			</li>
			<li>
				<span class="lang-en">Merit Student</span>
				<span class="lang-zh">校级三好学生</span>
			</li>
			<li>
				<span class="lang-en">Outstanding League Member</span>
				<span class="lang-zh">校级优秀共青团员</span>
			</li>
		</ul>

		<h3 class="subsection-title">
			<span class="lang-en">Ongoing</span>
			<span class="lang-zh">在研推进</span>
		</h3>
		<ul class="subsection-list">
			<li class="processing-item">
				<span class="lang-en">University Innovation &amp; Entrepreneurship Project (Ongoing)</span>
				<span class="lang-zh">大学生创新创业训练项目（进行中）</span>
			</li>
		</ul>
	</section>

	<section id="projects" class="split-section stagger-el">
		<h2 class="section-title">
			<span class="lang-en">Featured Projects</span>
			<span class="lang-zh">精选项目</span>
		</h2>
		<p class="section-desc">
			<span class="lang-en">Core 3D spatial computing, interactive product prototypes, and kinematics simulation demos with live deployments.</span>
			<span class="lang-zh">涵盖 3D 空间交互原型、工业级交互演示与动力学仿真短片，均已支持在线直接体验与试玩。</span>
		</p>
		<div class="projects-listing">
			{featuredProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>
		<div class="projects-more-cta">
			<a class="button" href={`${baseUrl}/projects`}>
				<span class="lang-en">View all 6 engineering projects &amp; toolchains &rarr;</span>
				<span class="lang-zh">浏览全部 6 个工程项目与工具链 &rarr;</span>
			</a>
		</div>
	</section>
</SplitLayout>
