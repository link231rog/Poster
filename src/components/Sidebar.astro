---
/**
 * Sidebar.astro - Sticky left sidebar with CV info and section nav.
 * Brittany Chiang style layout.
 */
import type { Profile } from '../types/content';

type Props = {
	profile: Profile;
	activeSection?: string;
	sections: Array<{ id: string; label: string; labelZh?: string }>;
};

const { profile, activeSection = '', sections } = Astro.props;
---

<aside class="sidebar stagger-el">
	<div class="sidebar-inner">
		<div class="sidebar-identity">
			<h1 class="sidebar-name">
				<span class="lang-en">{profile.name}</span>
				<span class="lang-zh">{profile.nameZh || profile.name}</span>
			</h1>
			<p class="sidebar-headline">
				<span class="lang-en">{profile.headline}</span>
				<span class="lang-zh">{profile.headlineZh || profile.headline}</span>
			</p>
			<div class="sidebar-cv">
				<div class="cv-cluster">
					<span class="cv-cluster-label">
						<span class="lang-en">Research</span>
						<span class="lang-zh">科研经历</span>
					</span>
					<p class="cv-cluster-text">
						<span class="lang-en">Research Assistant, <a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">DIGAI Lab</a>, HKUST(GZ)</span>
						<span class="lang-zh">研究助理，<a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">DIGAI Lab</a>，港科大（广州）</span>
					</p>
					<p class="cv-cluster-text">
						<span class="lang-en">Advised by <a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">Prof. Menglin Yang</a> · Agent Memory</span>
						<span class="lang-zh">导师：<a href="https://yangmenglinsite.github.io/" target="_blank" rel="noreferrer">杨梦霖教授</a> · 智能体记忆 (Agent Memory)</span>
					</p>
					<p class="cv-cluster-text">
						<span class="lang-en">Member of <a href="https://huangjunjie-cs.github.io/" target="_blank" rel="noreferrer">EZE LAB</a> · AI Agent</span>
						<span class="lang-zh">成员，<a href="https://huangjunjie-cs.github.io/" target="_blank" rel="noreferrer">EZE LAB</a> · AI Agent</span>
					</p>
				</div>
				<div class="cv-cluster">
					<span class="cv-cluster-label">
						<span class="lang-en">Background</span>
						<span class="lang-zh">教育背景</span>
					</span>
					<p class="cv-cluster-text">
						<span class="lang-en">B.Eng. in Automation, Southwest University (211)</span>
						<span class="lang-zh">自动化工学学士，西南大学（211）</span>
					</p>
				</div>
				<div class="cv-cluster">
					<span class="cv-cluster-label">
						<span class="lang-en">Publications</span>
						<span class="lang-zh">学术成果</span>
					</span>
					<p class="cv-cluster-text">
						<span class="lang-en">ARR Oct 2026 under review (1st author)</span>
						<span class="lang-zh">ARR 2026年10月在审（第一作者）</span>
					</p>
					<p class="cv-cluster-text">
						<span class="lang-en">Multi-Agent, Memory &amp; RL · HKUST(GZ), Tencent, SWU</span>
						<span class="lang-zh">Multi-Agent, Memory &amp; RL · 港科大（广州）、腾讯、西南大学</span>
					</p>
				</div>
				<div class="cv-cluster cv-profile">
					<span class="cv-cluster-label">
						<span class="lang-en">Profile</span>
						<span class="lang-zh">个人特质</span>
					</span>
					<p class="cv-cluster-text">ENTJ</p>
					<p class="cv-cluster-text">
						<span class="lang-en">Photography · 3D printing · Fitness · Board games · Indie games</span>
						<span class="lang-zh">摄影 · 3D 打印 · 健身 · 桌游 · 独立游戏</span>
					</p>
				</div>
			</div>
		</div>

		<nav class="sidebar-nav" aria-label="In-page navigation">
			{sections.map((s) => (
				<a
					href={`#${s.id}`}
					class:list={['sidebar-nav-link', activeSection === s.id && 'is-active']}
					data-section={s.id}
				>
					<span class="nav-indicator"></span>
					<span class="nav-label">
						<span class="lang-en">{s.label}</span>
						<span class="lang-zh">{s.labelZh || s.label}</span>
					</span>
				</a>
			))}
		</nav>

		<ul class="sidebar-socials text-links">
			{profile.socials.map((social) => (
				<li><a href={social.url} target="_blank" rel="noreferrer">{social.label}</a></li>
			))}
		</ul>
	</div>
</aside>

<script>
(() => {
	// Activation-line approach for active nav state.
	const links = document.querySelectorAll('.sidebar-nav-link');
	if (!links.length) return;

	const scrollRoot = document.querySelector('.split-content');
	if (!scrollRoot) return;
	const isScrollable = () => scrollRoot.scrollHeight > scrollRoot.clientHeight + 2;

	const sections = document.querySelectorAll('section[id]');
	if (!sections.length) return;

	const ACTIVATION_OFFSET = 120;

	function setActive(id: string) {
		links.forEach((link) => {
			link.classList.toggle('is-active', (link as HTMLElement).dataset.section === id);
		});
	}

	function updateActiveSection() {
		// Only use scroll-bottom guard when container is actually scrollable
		// (desktop .split-content with overflow-y:auto; on mobile it's overflow:visible)
		if (isScrollable() && scrollRoot.scrollHeight - scrollRoot.scrollTop <= scrollRoot.clientHeight + 1) {
			setActive(sections[sections.length - 1].id);
			return;
		}

		const scrollRect = scrollRoot.getBoundingClientRect();
		const activationLine = scrollRect.top + ACTIVATION_OFFSET;

		let activeId = sections[0].id;
		for (let i = 0; i < sections.length; i++) {
			const rect = sections[i].getBoundingClientRect();
			if (activationLine >= rect.top) {
				activeId = sections[i].id;
			} else {
				break;
			}
		}

		setActive(activeId);
	}

	function onScroll() {
		if (!ticking) {
			requestAnimationFrame(() => {
				updateActiveSection();
				ticking = false;
			});
			ticking = true;
		}
	}

	let ticking = false;
	// On desktop: .split-content is the scroll container (overflow-y:auto).
	// On mobile: window is the scroll container (split-content is overflow:visible).
	// Listen on both; the non-scrolling one simply never fires.
	scrollRoot.addEventListener('scroll', onScroll, { passive: true });
	window.addEventListener('scroll', onScroll, { passive: true });

	let resizeTimer: ReturnType<typeof setTimeout>;
	window.addEventListener('resize', () => {
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(updateActiveSection, 100);
	});

	updateActiveSection();
})();
</script>
