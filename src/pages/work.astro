---
// This page has moved to the homepage (/).
// Minimal static redirect — meta refresh + JS fallback.
// import.meta.env.BASE_URL is inlined by Vite at build time (even inside <script>).
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Redirecting…</title>
		<meta http-equiv="refresh" content={`0; url=${import.meta.env.BASE_URL}/`} />
		<script>location.replace(import.meta.env.BASE_URL + '/')</script>
	</head>
	<body>
		<p>Moved. <a href={`${import.meta.env.BASE_URL}/`}>Click here</a> if not redirected.</p>
	</body>
</html>
