---
/**
 * SplitLayout.astro - Split layout: sidebar + content (Brittany Chiang style).
 */
import type { NavigationItem, Profile } from '../types/content';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import AnimateOnScroll from '../components/AnimateOnScroll.astro';
import ParticleField from '../components/ParticleField.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangToggle from '../components/LangToggle.astro';
import '../styles/global.css';

type Props = {
	title: string;
	description: string;
	navigation: NavigationItem[];
	profile: Profile;
	pathname?: string;
	activeSection?: string;
	sidebarSections: Array<{ id: string; label: string }>;
};

const { title, description, navigation, profile, pathname = '/', activeSection = '', sidebarSections } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
		<title>{title}</title>
		<script is:inline>
			(() => {
				function applyPreferences(doc = document) {
					const root = doc.documentElement;
					const savedTheme = localStorage.getItem('theme');
					if (savedTheme) {
						root.setAttribute('data-theme', savedTheme);
					} else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
						root.setAttribute('data-theme', 'light');
					} else {
						root.setAttribute('data-theme', 'dark');
					}

					const savedLang = localStorage.getItem('lang');
					if (savedLang) {
						root.setAttribute('data-lang', savedLang);
					} else {
						const isZh = navigator.language && navigator.language.startsWith('zh');
						root.setAttribute('data-lang', isZh ? 'zh' : 'en');
					}
				}

				applyPreferences(document);

				// Persist attributes across Astro ClientRouter SPA navigations
				document.addEventListener('astro:before-swap', (ev) => {
					applyPreferences(ev.newDocument);
				});
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		<ParticleField transition:persist />
		<div class="grain-overlay" transition:persist></div>

		<div class="split-shell page-enter">
			<header class="split-topbar" data-animate="fade">
				<a class="brand" href={`${import.meta.env.BASE_URL}`}>Link</a>
				<nav style="display: flex; align-items: center; gap: 8px;">
					<ul class="nav-list">
						{navigation.map((item) => (
							<li>
								<a class:list={[pathname === item.href && 'is-active']} href={`${import.meta.env.BASE_URL}${item.href === '/' ? '' : '/' + item.href.slice(1)}`}>
									<span class="lang-en">{item.label}</span>
									<span class="lang-zh">{item.labelZh || item.label}</span>
								</a>
							</li>
						))}
					</ul>
					<LangToggle />
					<ThemeToggle />
				</nav>
			</header>

			<div class="split-layout">
				<Sidebar profile={profile} activeSection={activeSection} sections={sidebarSections} />
				<main class="split-content stagger-el">
					<slot />
					<footer class="split-footer">
						<p>Built with Astro. Static by design.</p>
					</footer>
				</main>
			</div>
		</div>
		<AnimateOnScroll />
	</body>
</html>

<script>
document.addEventListener('astro:page-load', () => {
	// ── Stagger entrance ──
	const split = document.querySelector('.split-layout');
	if (split) {
		if (!window._staggerReady) {
			split.querySelectorAll('.stagger-el').forEach((el) => {
				(el as HTMLElement).style.opacity = '1';
				(el as HTMLElement).style.transform = 'translateY(0)';
			});
			window._staggerReady = true;
		} else {
			split.querySelectorAll('.stagger-el').forEach((el, i) => {
				(el as HTMLElement).style.setProperty('--stagger-delay', `${i * 0.07}s`);
				el.classList.add('stagger-enter');
			});
		}
	}
});
</script>
