---
import type { Project } from '../types/content';

type Props = {
	project: Project;
};

const { project } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const coverSrc = project.cover
	? project.cover.startsWith('http')
		? project.cover
		: `${baseUrl}${project.cover}`
	: null;
---

<article class="project-card editorial-card">
	{coverSrc && (
		<a
			href={project.demo || '#'}
			target={project.demo ? '_blank' : undefined}
			rel={project.demo ? 'noreferrer' : undefined}
			class="project-cover-link"
			tabindex="-1"
			aria-hidden="true"
		>
			<div class="project-cover-wrapper">
				<img
					src={coverSrc}
					alt={project.title}
					loading="lazy"
					decoding="async"
					class="project-cover-img"
				/>
				<div class="project-cover-overlay">
					<span class="project-cover-badge">
						<span class="lang-en">Open Preview ↗</span>
						<span class="lang-zh">立即体验 ↗</span>
					</span>
				</div>
			</div>
		</a>
	)}
	<div class="section">
		<div class="section-head">
			<h3>
				{project.demo ? (
					<a href={project.demo} target="_blank" rel="noreferrer" class="project-title-link">
						<span class="lang-en">{project.title}</span>
						<span class="lang-zh">{project.titleZh || project.title}</span>
					</a>
				) : (
					<>
						<span class="lang-en">{project.title}</span>
						<span class="lang-zh">{project.titleZh || project.title}</span>
					</>
				)}
			</h3>
			<span class="meta">{project.year}</span>
		</div>
		<p class="lang-en">{project.summary}</p>
		<p class="lang-zh">{project.summaryZh || project.summary}</p>
	</div>
	{(project.demo || project.repo) && (
		<div class="project-urls-list">
			{project.demo && (
				<div class="project-url">
					<span class="eyebrow" style="font-size: 11px; min-width: 44px;">{project.repo ? 'DEMO:' : 'URL:'}</span>
					<a href={project.demo} target="_blank" rel="noreferrer" class="project-url-link">
						{project.demo}
					</a>
				</div>
			)}
			{project.repo && (
				<div class="project-url">
					<span class="eyebrow" style="font-size: 11px; min-width: 44px;">REPO:</span>
					<a href={project.repo} target="_blank" rel="noreferrer" class="project-url-link">
						{project.repo}
					</a>
				</div>
			)}
		</div>
	)}
	<ul class="tag-list muted-tags">
		{project.tags.map((tag) => <li class="tag">{tag}</li>)}
	</ul>
	{((project.links && project.links.length > 0) || project.repo) && (
		<div class="cta-row" style="margin-top: 14px;">
			{project.links && project.links.map((link) => (
				<a class="button-secondary" href={link.url} target="_blank" rel="noreferrer">
					<span class="lang-en">{link.label} ↗</span>
					<span class="lang-zh">{link.labelZh || link.label} ↗</span>
				</a>
			))}
			{project.repo && (
				<a class="button-secondary" href={project.repo} target="_blank" rel="noreferrer">
					<span class="lang-en">GitHub (Open Source) ↗</span>
					<span class="lang-zh">开源仓库 ↗</span>
				</a>
			)}
		</div>
	)}
</article>

