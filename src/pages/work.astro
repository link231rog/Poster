---
// This page has moved to the homepage (/).
// Minimal static redirect — meta refresh + JS fallback.
// import.meta.env.BASE_URL is inlined by Vite at build time (even inside <script>).
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Redirecting…</title>
		<meta http-equiv="refresh" content={`0; url=${baseUrl}`} />
		<script define:vars={{ baseUrl }}>location.replace(baseUrl)</script>
	</head>
	<body>
		<p>Moved. <a href={baseUrl}>Click here</a> if not redirected.</p>
	</body>
</html>
