---
/**
 * SplitLayout.astro - Split layout (2-column) or Three-column layout (/work).
 * layout="split" (default): Brittany Chiang style sidebar + content.
 * layout="three-column": left profile + middle progress bar + right content.
 */
import type { NavigationItem, Profile } from '../types/content';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import AnimateOnScroll from '../components/AnimateOnScroll.astro';
import ParticleField from '../components/ParticleField.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import '../styles/global.css';

type Props = {
	title: string;
	description: string;
	navigation: NavigationItem[];
	profile: Profile;
	pathname?: string;
	activeSection?: string;
	sidebarSections: Array<{ id: string; label: string }>;
	layout?: 'split' | 'three-column';
	workSections?: Array<{ id: string; label: string }>;
};

const { title, description, navigation, profile, pathname = '/', activeSection = '', sidebarSections, layout = 'split', workSections = [] } = Astro.props;
const pairedTo = pathname === '/work' ? 'gate-work' : pathname === '/travel' ? 'gate-life' : undefined;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<ParticleField transition:persist />
		<ScrollProgress />
		<div class="grain-overlay" transition:persist></div>

		<div class="split-shell page-enter">
			<header class="split-topbar" data-animate="fade">
				<a class="brand" href={`${import.meta.env.BASE_URL}`}>Link</a>
				<nav>
					<ul class="nav-list">
						{navigation.map((item) => (
							<li>
								<a class:list={[pathname === item.href && 'is-active']} href={`${import.meta.env.BASE_URL}${item.href === '/' ? '' : '/' + item.href.slice(1)}`}>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</header>

			{layout === 'three-column' ? (
				<div class="work-layout">
					<aside class="work-left">
						<slot name="work-left" />
					</aside>
					<div class="work-progress" role="navigation" aria-label="Section navigation">
						{workSections.map((s, i) => (
							<a href={`#${s.id}`} class="work-progress-dot" data-section={s.id}>
								<span class="work-progress-marker"></span>
								<span class="work-progress-label">{s.label}</span>
							</a>
						))}
						<div class="work-progress-track"></div>
					</div>
					<main class="work-content">
						<slot />
						<footer class="split-footer">
							<p>Built with Astro. Static by design.</p>
						</footer>
					</main>
				</div>
			) : (
				<div class="split-layout">
					<Sidebar profile={profile} activeSection={activeSection} sections={sidebarSections} pairedTo={pairedTo} />
					<main class="split-content stagger-el">
						<slot />
						<footer class="split-footer">
							<p>Built with Astro. Static by design.</p>
						</footer>
					</main>
				</div>
			)}
		</div>
		<AnimateOnScroll />
	</body>
</html>

<script>
document.addEventListener('astro:page-load', () => {
	// ── Stagger entrance ──
	const split = document.querySelector('.split-layout') || document.querySelector('.work-layout');
	if (split) {
		if (!window._staggerReady) {
			split.querySelectorAll('.stagger-el').forEach((el) => {
				(el as HTMLElement).style.opacity = '1';
				(el as HTMLElement).style.transform = 'translateY(0)';
			});
			window._staggerReady = true;
		} else {
			split.querySelectorAll('.stagger-el').forEach((el, i) => {
				(el as HTMLElement).style.setProperty('--stagger-delay', `${i * 0.07}s`);
				el.classList.add('stagger-enter');
			});
		}
	}

	// ── Work progress bar ──
	const dots = document.querySelectorAll('.work-progress-dot');
	if (!dots.length) return;

	const sections: HTMLElement[] = [];
	dots.forEach((dot) => {
		const id = (dot as HTMLElement).dataset.section;
		const el = document.getElementById(id!);
		if (el) sections.push(el);
	});

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const id = entry.target.id;
					dots.forEach((d) => {
						d.classList.toggle('is-active', (d as HTMLElement).dataset.section === id);
					});
				}
			});
		},
		{ threshold: 0.3, rootMargin: '-80px 0px -50% 0px' }
	);

	sections.forEach((el) => observer.observe(el));

	// Activate first dot by default
	if (sections.length && !document.querySelector('.work-progress-dot.is-active')) {
		dots[0].classList.add('is-active');
	}
});
</script>
