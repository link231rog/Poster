---
import type { Project } from '../types/content';

type Props = {
	project: Project;
};

const { project } = Astro.props;
---

<article class="project-card editorial-card">
	<div class="section">
		<div class="section-head">
			<h3>{project.title}</h3>
			<span class="meta">{project.year}</span>
		</div>
		<p>{project.summary}</p>
	</div>
	{project.demo && (
		<div class="project-url">
			<span class="eyebrow" style="margin-right: 6px; font-size: 11px;">URL:</span>
			<a href={project.demo} target="_blank" rel="noreferrer" class="project-url-link">
				{project.demo}
			</a>
		</div>
	)}
	<ul class="tag-list muted-tags">
		{project.tags.map((tag) => <li class="tag">{tag}</li>)}
	</ul>
	<div class="cta-row">
		{project.demo && (
			<a class="button" href={project.demo} target="_blank" rel="noreferrer">Live Demo ↗</a>
		)}
		{project.links && project.links.map((link) => (
			<a class="button-secondary" href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>
		))}
		{project.repo && (
			<a class="button-secondary" href={project.repo} target="_blank" rel="noreferrer">GitHub</a>
		)}
	</div>
</article>
