---
import ProjectCard from '../components/ProjectCard.astro';
import SplitLayout from '../layouts/SplitLayout.astro';
import { getProjectsPageData, getSiteData } from '../lib/content';

const [site, page] = await Promise.all([getSiteData(), getProjectsPageData()]);

const projectSections = [
	{ id: 'interactive', label: 'Interactive & 3D', labelZh: '3D 与空间交互' },
	{ id: 'agents', label: 'Agent Systems', labelZh: '智能体系统' },
	{ id: 'tools', label: 'Tools & Systems', labelZh: '工具与工作流' },
];

const interactiveProjects = page.projects.filter(
	(p) =>
		p.slug === 'chongqing-3d' ||
		p.slug === 'fan-demo' ||
		p.slug === 'fan-promo' ||
		p.tags.includes('three.js') ||
		p.tags.includes('webgl') ||
		p.tags.includes('interactive') ||
		p.tags.includes('concept-prototype') ||
		p.tags.includes('product-promo'),
);
const agentProjects = page.projects.filter(
	(p) =>
		(p.tags.includes('agents') ||
			p.tags.includes('tooling') ||
			p.slug === 'agent-orchestration' ||
			p.slug === 'harness-toolkit') &&
		!interactiveProjects.includes(p),
);
const toolProjects = page.projects.filter(
	(p) => !interactiveProjects.includes(p) && !agentProjects.includes(p),
);
---

<SplitLayout
	title={`Projects · ${site.seo.title}`}
	description="Selected engineering, spatial 3D, and AI agent projects."
	navigation={site.navigation.items}
	profile={site.profile}
	pathname="/projects"
	activeSection="interactive"
	sidebarSections={projectSections}
>
	<section id="interactive" class="split-section stagger-el">
		<h2 class="section-title">
			<span class="lang-en">Interactive &amp; 3D</span>
			<span class="lang-zh">3D 与空间交互</span>
		</h2>
		<p class="section-desc">
			<span class="lang-en">Spatial computing, WebGL 3D graphics, and real-time interactive experiences.</span>
			<span class="lang-zh">空间计算、WebGL 3D 渲染与实时交互体验。</span>
		</p>
		<div class="projects-listing">
			{interactiveProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>
	</section>

	<section id="agents" class="split-section stagger-el">
		<h2 class="section-title">
			<span class="lang-en">Agent Systems</span>
			<span class="lang-zh">智能体系统</span>
		</h2>
		<p class="section-desc">
			<span class="lang-en">Multi-agent collaboration, model routing, and agent harness workflows.</span>
			<span class="lang-zh">多智能体协同、模型动态路由与 Harness 工程体系。</span>
		</p>
		<div class="projects-listing">
			{agentProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>
	</section>

	<section id="tools" class="split-section stagger-el">
		<h2 class="section-title">
			<span class="lang-en">Tools &amp; Systems</span>
			<span class="lang-zh">工具与工作流</span>
		</h2>
		<p class="section-desc">
			<span class="lang-en">Developer toolchains, documentation systems, and web architecture.</span>
			<span class="lang-zh">开发者工具链、上下文工程体系与 Web 架构。</span>
		</p>
		<div class="projects-listing">
			{toolProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>
	</section>
</SplitLayout>
