---
/**
 * WireframeGlobe.astro — Animated SVG wireframe sphere inspired by Mimo AI
 * Pure CSS/SVG, no external libraries
 */
---

<div class="wireframe-globe" aria-hidden="true">
  <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" class="globe-svg">
    <defs>
      <!-- Glow filter for nodes -->
      <filter id="node-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <!-- Gradient for subtle sphere shading -->
      <radialGradient id="sphere-shade" cx="30%" cy="30%" r="70%">
        <stop offset="0%" stop-color="rgba(245,245,240,0.03)" />
        <stop offset="100%" stop-color="transparent" />
      </radialGradient>
    </defs>

    <!-- Rotating group -->
    <g class="globe-rotate-group">
      <!-- Outer sphere outline -->
      <circle cx="200" cy="200" r="160" fill="none" stroke="rgba(245,245,240,0.12)" stroke-width="1" />

      <!-- Latitude lines (horizontal) -->
      <ellipse cx="200" cy="200" rx="160" ry="40" fill="none" stroke="rgba(245,245,240,0.08)" stroke-width="0.8" />
      <ellipse cx="200" cy="200" rx="160" ry="80" fill="none" stroke="rgba(245,245,240,0.08)" stroke-width="0.8" />
      <ellipse cx="200" cy="200" rx="160" ry="120" fill="none" stroke="rgba(245,245,240,0.08)" stroke-width="0.8" />
      <ellipse cx="200" cy="200" rx="138" ry="160" fill="none" stroke="rgba(245,245,240,0.06)" stroke-width="0.8" />

      <!-- Longitude arcs (vertical-ish, drawn as arcs) -->
      <path d="M 200,40 A 160,160 0 0,1 200,360" fill="none" stroke="rgba(245,245,240,0.08)" stroke-width="0.8" />
      <path d="M 200,40 A 160,160 0 0,0 200,360" fill="none" stroke="rgba(245,245,240,0.08)" stroke-width="0.8" />
      <path d="M 80,200 A 138,160 0 0,0 320,200" fill="none" stroke="rgba(245,245,240,0.07)" stroke-width="0.8" />
      <path d="M 80,200 A 138,160 0 0,1 320,200" fill="none" stroke="rgba(245,245,240,0.07)" stroke-width="0.8" />
      <path d="M 120,80 A 160,160 0 0,1 280,320" fill="none" stroke="rgba(245,245,240,0.06)" stroke-width="0.8" />
      <path d="M 120,320 A 160,160 0 0,0 280,80" fill="none" stroke="rgba(245,245,240,0.06)" stroke-width="0.8" />

      <!-- Dotted landmass silhouettes (abstract dots) -->
      <g fill="rgba(245,245,240,0.15)">
        <circle cx="160" cy="140" r="2" />
        <circle cx="170" cy="135" r="1.5" />
        <circle cx="155" cy="150" r="2" />
        <circle cx="165" cy="155" r="1.5" />
        <circle cx="175" cy="145" r="2" />
        <circle cx="180" cy="160" r="1.5" />
        <circle cx="150" cy="165" r="2" />
        <circle cx="170" cy="170" r="1.5" />
        <circle cx="185" cy="150" r="2" />
        <circle cx="190" cy="165" r="1.5" />
        <circle cx="145" cy="180" r="2" />
        <circle cx="160" cy="185" r="1.5" />
        <circle cx="175" cy="180" r="2" />
        <circle cx="165" cy="190" r="1.5" />
        <circle cx="155" cy="195" r="1.5" />
        <circle cx="180" cy="175" r="2" />
        <circle cx="190" cy="185" r="1.5" />
        <circle cx="170" cy="200" r="1.5" />
        <circle cx="185" cy="195" r="2" />
        <circle cx="195" cy="180" r="1.5" />
        <circle cx="200" cy="190" r="1.5" />
        <circle cx="210" cy="170" r="2" />
        <circle cx="220" cy="160" r="1.5" />
        <circle cx="230" cy="175" r="2" />
        <circle cx="215" cy="185" r="1.5" />
        <circle cx="225" cy="190" r="1.5" />
        <circle cx="235" cy="180" r="2" />
        <circle cx="240" cy="165" r="1.5" />
        <circle cx="205" cy="205" r="1.5" />
        <circle cx="195" cy="210" r="2" />
        <circle cx="185" cy="215" r="1.5" />
        <circle cx="175" cy="210" r="2" />
        <circle cx="165" cy="220" r="1.5" />
        <circle cx="155" cy="215" r="1.5" />
        <circle cx="145" cy="225" r="2" />
        <circle cx="160" cy="230" r="1.5" />
        <circle cx="170" cy="235" r="2" />
        <circle cx="180" cy="225" r="1.5" />
        <circle cx="190" cy="230" r="2" />
        <circle cx="200" cy="220" r="1.5" />
        <circle cx="210" cy="235" r="1.5" />
        <circle cx="220" cy="225" r="2" />
        <circle cx="230" cy="230" r="1.5" />
        <circle cx="240" cy="220" r="2" />
        <circle cx="250" cy="210" r="1.5" />
        <circle cx="255" cy="195" r="2" />
        <circle cx="245" cy="185" r="1.5" />
        <circle cx="235" cy="200" r="1.5" />
        <circle cx="225" cy="205" r="2" />
        <circle cx="215" cy="215" r="1.5" />
        <circle cx="205" cy="200" r="2" />
      </g>

      <!-- Colored accent nodes -->
      <!-- Cyan node -->
      <g class="globe-node node-cyan" filter="url(#node-glow)">
        <circle cx="140" cy="120" r="5" fill="#4ecdc4" opacity="0.9" />
        <circle cx="140" cy="120" r="10" fill="none" stroke="#4ecdc4" stroke-width="0.5" opacity="0.4" />
      </g>
      <!-- Green node -->
      <g class="globe-node node-green" filter="url(#node-glow)">
        <circle cx="260" cy="160" r="4" fill="#a8e6cf" opacity="0.9" />
        <circle cx="260" cy="160" r="8" fill="none" stroke="#a8e6cf" stroke-width="0.5" opacity="0.4" />
      </g>
      <!-- Peach node -->
      <g class="globe-node node-peach" filter="url(#node-glow)">
        <circle cx="180" cy="260" r="5" fill="#ffaaa5" opacity="0.9" />
        <circle cx="180" cy="260" r="10" fill="none" stroke="#ffaaa5" stroke-width="0.5" opacity="0.4" />
      </g>
      <!-- White node -->
      <g class="globe-node node-white" filter="url(#node-glow)">
        <circle cx="230" cy="240" r="4" fill="#f5f5f0" opacity="0.9" />
        <circle cx="230" cy="240" r="8" fill="none" stroke="#f5f5f0" stroke-width="0.5" opacity="0.4" />
      </g>

      <!-- Connection lines between nodes -->
      <line x1="140" y1="120" x2="260" y2="160" stroke="rgba(78,205,196,0.25)" stroke-width="0.8" stroke-dasharray="4 4" class="node-line" />
      <line x1="260" y1="160" x2="230" y2="240" stroke="rgba(168,230,207,0.2)" stroke-width="0.8" stroke-dasharray="4 4" class="node-line" />
      <line x1="230" y1="240" x2="180" y2="260" stroke="rgba(245,245,240,0.2)" stroke-width="0.8" stroke-dasharray="4 4" class="node-line" />
      <line x1="180" y1="260" x2="140" y2="120" stroke="rgba(255,170,165,0.2)" stroke-width="0.8" stroke-dasharray="4 4" class="node-line" />
    </g>

    <!-- Static overlay shade for depth -->
    <circle cx="200" cy="200" r="160" fill="url(#sphere-shade)" pointer-events="none" />
  </svg>
</div>
